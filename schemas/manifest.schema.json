{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "language", "command", "hooks", "timeout"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "homepage": { "type": "string" },
    "min_app_version": { "type": "string" },
    "max_app_version": { "type": "string" },
    "command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "hooks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 60 },
    "compatibility": {
      "type": "object",
      "properties": {
        "min_app_version": { "type": "string" },
        "max_app_version": { "type": "string" }
      },
      "required": ["min_app_version", "max_app_version"]
    }
  }
}
